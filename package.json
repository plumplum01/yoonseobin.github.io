{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:types && npm run build:sanity && tsc -b && vite build",
    "build:sanity": "tsc -p packages/sanity/tsconfig.json",
    "build:types": "tsc -p packages/types/tsconfig.json",
    "check": "biome check --formatter-enabled=false --assist-enabled=false .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "sanity:build": "npm --workspace @portfolio/sanity run studio:build",
    "sanity:deploy": "npm --workspace @portfolio/sanity run deploy",
    "sanity:dev": "npm --workspace @portfolio/sanity run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@portfolio/sanity": "file:packages/sanity",
    "@portfolio/types": "file:packages/types",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.21",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.4"
  }
}
